terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

module "postgresql" {
  source      = "../modules/postgresql"
  service     = "execution"
  db_password = var.db_password
}
